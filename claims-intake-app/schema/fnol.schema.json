{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uipath.com/fde-implementations/claims-intake-app/fnol.schema.json",
  "title": "FNOL payload",
  "type": "object",
  "required": ["intakeId", "submittedAt", "claimant", "incident", "attachments"],
  "properties": {
    "intakeId": { "type": "string", "description": "UUID generated at submission time." },
    "submittedAt": { "type": "string", "format": "date-time" },
    "claimant": {
      "type": "object",
      "required": ["name", "contact"],
      "properties": {
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "policyNumber": { "type": ["string", "null"] }
      }
    },
    "incident": {
      "type": "object",
      "required": ["date", "location", "narrative"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "location": { "type": "string" },
        "narrative": { "type": "string", "minLength": 40 }
      }
    },
    "attachments": {
      "type": "array",
      "items": { "$ref": "./document-attachment.schema.json" }
    }
  }
}
