{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uipath.com/fde-implementations/claims-intake-app/document-attachment.schema.json",
  "title": "Document attachment with classification",
  "type": "object",
  "required": ["fileName", "mimeType", "sizeBytes", "storageRef", "classification"],
  "properties": {
    "fileName": { "type": "string" },
    "mimeType": { "type": "string" },
    "sizeBytes": { "type": "integer", "minimum": 0 },
    "storageRef": { "type": "string", "description": "Bucket reference where the binary lives." },
    "classification": {
      "type": "object",
      "required": ["taxonomyNode", "confidence"],
      "properties": {
        "taxonomyNode": { "type": "string", "description": "Path in the taxonomy tree, e.g., 'evidence.photo'." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "humanReviewRequired": { "type": "boolean" },
        "modelVersion": { "type": "string" }
      }
    }
  }
}
